# Copiar a .env.docker y completar. Este archivo NO se commitea ni va dentro de la imagen.
#
# OBLIGATORIAS (si falta alguna, el contenedor no arranca y avisa cuál):
#   DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, DJANGO_CSRF_TRUSTED_ORIGINS, SITE_BASE_URL,
#   MYSQL_DB, MYSQL_USER, MYSQL_PASSWORD, MYSQL_HOST
# Todo lo demás es opcional (tiene un valor por defecto o apaga esa función).
#
# Generar la clave:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=generar-una-clave-larga-y-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=implementacion.napsislatam.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://implementacion.napsislatam.com
SITE_BASE_URL=https://implementacion.napsislatam.com

# MySQL existente de Napsis. El usuario necesita permisos de esquema
# (CREATE/ALTER/DROP/INDEX además del CRUD) para correr las migraciones.
MYSQL_DB=napsis_portal
MYSQL_USER=napsis
MYSQL_PASSWORD=cambiar
MYSQL_HOST=mysql.interno.napsislatam.com
MYSQL_PORT=3306

# Superusuario inicial (opcional: sin esto no se crea ninguno; se crea una sola vez, si ya existe no se toca).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=implementacion@napsislatam.com
DJANGO_SUPERUSER_PASSWORD=cambiar

# Mails al equipo de implementación
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=portal@napsislatam.com
IMPLEMENTATION_TEAM_EMAILS=implementacion@napsislatam.com
GOOGLE_SHEETS_WEBHOOK_URL=
