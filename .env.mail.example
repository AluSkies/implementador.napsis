# Configuración del correo SALIENTE. La completa el equipo de deploy; el resto del equipo
# no necesita tocarla. Copiar a .env.mail (junto a .env.docker). NO se commitea ni va en la imagen.
# Guía completa: deploy/CORREO.md
#
# Sin este archivo la app arranca igual pero NO envía mails (los imprime en el log):
# no salen invitaciones, recuperación de contraseña ni avisos.

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 usa STARTTLS (EMAIL_USE_TLS=true). Con el puerto 465 usar EMAIL_USE_SSL=true y EMAIL_USE_TLS=false.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Segundos de espera al servidor SMTP antes de rendirse.
EMAIL_TIMEOUT=10
# Remitente de todos los mails. Tiene que ser una casilla válida del dominio (y la autenticada
# o una con permiso de "enviar como"); con SPF/DKIM configurados para que no caigan en spam.
DEFAULT_FROM_EMAIL=portal@napsislatam.com
