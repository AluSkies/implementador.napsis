[Unit]
Description=Portal de Implementación Napsis (gunicorn)
After=network.target mysql.service

[Service]
User=napsis
Group=www-data
WorkingDirectory=/opt/napsis-portal
EnvironmentFile=/opt/napsis-portal/.env
RuntimeDirectory=napsis-portal
RuntimeDirectoryMode=0750

; 2 workers alcanza y sobra para uso interno — no competir por RAM con lo
; demás que corre en la máquina. --max-requests recicla los workers de tanto
; en tanto para que no vayan acumulando memoria (pandas/openpyxl pesan).
ExecStart=/opt/napsis-portal/venv/bin/gunicorn config.wsgi:application \
    --workers 2 \
    --threads 2 \
    --worker-tmp-dir /dev/shm \
    --max-requests 500 \
    --max-requests-jitter 50 \
    --bind unix:/run/napsis-portal/gunicorn.sock \
    --umask 007

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
