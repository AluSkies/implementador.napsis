# SOLO PARA DESARROLLO LOCAL (copiar a .env en tu máquina). DEBUG=true muestra errores detallados:
# NUNCA usar este archivo en un servidor. Para producción: .env.docker.example (DJANGO_DEBUG=false).

DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=portal@napsislatam.com

IMPLEMENTATION_TEAM_EMAILS=implementacion@napsislatam.com
SITE_BASE_URL=http://localhost:8000
